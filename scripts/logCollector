#!/bin/bash
    shopt -s extglob
    set -o pipefail
    start=$(date +%s.%N)
    version=1.00;

    prsopts=("s" "f" "i" "d" "a");
    keywords=("samples" "frequency" "interface" "debug" "analyze");

## Configuration Options:    

## Preamble:
    ## Install Dependencies
    
        dpkg -s terminator > /dev/null 2>&1 || { echo "Installing package terminator, please verify user passphrase:"; sudo apt-get install terminator; };

    ## Define Variables
      
        s='tput sgr0';                                          # Bash tput colors - default
        d='tput bold'; chnm='^[0-9]+$';                         # Bash tput input - bold | check_for_number
        clrstd=256; clrwrn=214; clrerr=196;                             # prtclr color input - standard | warning | error
        clrnom=113; clrqit=69; user=""    								# prtclr color input - nominal | quiet | user_email

        
        rootFolder="$HOME/Engineering/Python/VSCode/sensorData";
        [[ $(pwd) == $rootFolder ]] || cd "${rootFolder}";
        mkdir -p logs;


    ## Define Functions
        boottime () {   # Time since script start
            current=$(date +%s.%N);
            out="$(echo "$current - $start" | bc | awk '{printf "%.3f", $0}')"
            echo $out;
        }

        prtclr () {  # Print-to-terminal w/ various arguments                     # Input 1 = Text to print
                                                                                  # Input 2 = Text color        $t<n,e,w,s>color
            timestamp=$(boottime);                                                # Input 3 = Message Type      e for error; w for warning; q for quiet; n for nominal; empty for none
                                                                                  # Input 4 = Bold              Set input "d"
            [[ $4 = "d" ]] && tput bold;                                          # Input 5 = No extra line     Set input "n" for no extra space
            [[ $5 = "n" ]] && prtout="printf" || prtout="echo";
                case $3 in
                    e)  # Error message
                        outstatus=$($prtout "ERROR     [$timestamp]   $outclr");
                    ;;
                    w)  # Warning message
                        outstatus=$($prtout "WARNING   [$timestamp]   $outclr");
                    ;;
                    q)  # Quiet message
                        outstatus=$($prtout "QUIET     [$timestamp]   $outclr");
                    ;;
                    n)  # Status message
                        outstatus=$($prtout "STATUS    [$timestamp]   $outclr");
                    ;;
                    *)  # All other
                        outstatus=$($prtout "$outclr");
                    ;;
                esac

                local color="${2:-}"

                if [[ "$color" =~ ^[0-9]+$ ]] && (( color >= 0 && color < 256 )); then
                    local outclr
                    outclr=$(echo -e -n "\e[38;5;${color}m${outstatus}${1}")
                else
                    local outclr
                    outclr=$(echo -e -n "${outstatus}${1}")
                fi

            $prtout "$outclr";                                  # $prtout is the print-method (printf or echo). $outclr is the concatenated message with color applied
            $s;                                          # Set the terminal output back to default
        }

        ntbash () { # New terminal bash command                                                         # Input 1 = "<Command to run>"
        	terminator -T $title --new-tab -x > /dev/null 2>&1 "sh -c '$1; sleep 20000; exit;';";
            #gnome-terminal --tab -t $2 -e > /dev/null 2>&1 'sh -c "$1; sleep 20000; exit;"';            # Input 2 = "<terminal_title>"
        }

        countdown () {  # Pause script and terminal-output countdown
            [[ $2 = "down" ]] && inmt="--" || inmt="++";    # Input 2 = "down", then increment down. Otherwise, count up
            for (( i = $1; i > -1 && i < 20; i$inmt )); do
                echo -e -n "\r$i "; echo -e -n "seconds";
                [[ ! $i = 0 ]] && sleep 1;
            done
        }

## Pre-execution:

    ## Parse input for tasks:
        while (( $# > 0 )); do
            case "$1" in
                
                -${prsopts[0]}|--${keywords[0]})
                    prsact+=" ${prsopts[0]}"
                    option+=" ${keywords[0]}";
                    samplesRecorded+="$2";
                    shift
                    { texe+="1"; optname+=' task1'; };
                ;;

                -${prsopts[1]}|--${keywords[1]})
                    prsact+=" ${prsopts[1]}";
                    option+=" ${keywords[1]}";
                    frequencySamples+="$2";
                    shift
                    { texe+="1"; optname+=' task2'; };
                ;;

                -${prsopts[2]}|--${keywords[2]})
                    prsact+=" ${prsopts[2]}";
                    sensor_arg="${2//,/ }"        # allow "imu,dht11" too
                    read -r -a newSensors <<< "$sensor_arg"
                    sensors+=("${newSensors[@]}")
                    shift
                ;;
                
                -${prsopts[3]}|--${keywords[3]})
                    prsact+=" ${prsopts[3]}";
                    debug="True";
                ;;

                -${prsopts[4]}|--${keywords[4]})
                    prsact+=" ${prsopts[4]}";
                    analysis="True";
                ;;

                -h|--help)
                    echo $1;
                    cat ${rootFolder}/help;
                    echo
                    exit
                ;;
            esac
            shift   # While there are still input arguments to parse, do:
            
        done

## Functional Script:
    ## Available functions: boottime(), ckconnect(), prtclr(), ntssh(), ctssh(), ntbash(), countdown(), dyncheck()
    
    picoSerial="/dev/ttyACM0";
    validSensors=(imu dht11 sr04);

    declare -A script2Sensor;
    script2Sensor[imu]="${rootFolder}/scripts/mpuData.py";
    script2Sensor[dht11]="${rootFolder}/scripts/dht11Data.py";
    script2Sensor[sr04]="${rootFolder}/scripts/sr04Data.py";
        
    prtclr "Sensors to sample: ${sensors[@]}" "$clrnom" "n";
    prtclr "# samples to record: ${samplesRecorded}" "$clrstd" "n";
    prtclr "Sample frequency: ${frequencySamples}Hz" "$clrstd" "n";

    lsof -t $picoSerial | xargs -r kill || prtclr "No process holding serial port $picoSerial" "$clrwrn" "w";

    for sensor in "${sensors[@]}"; do     

        cfg="$(mktemp)";
            {
                printf 'collectData="%s"\n' "$sensor";
                [[ -n "$samplesRecorded" ]] && printf 'samplesRecorded=%s\n' "${samplesRecorded}"
                [[ -n "$frequencySamples" ]] && printf 'frequencySamples=%s\n' "${frequencySamples}"
            } > "$cfg"

            mpremote connect /dev/ttyACM0 fs cp "$cfg" :/run_config.py && \
            mpremote connect /dev/ttyACM0 fs cat :/run_config.py;
            rm "$cfg";

        script="${script2Sensor[$sensor]}";
                    
            [[ -n "$script" ]] || {
                prtclr "Unknown sensor '$sensor'. Known sensors: ${!script2Sensor[@]}" "$clrerr" "e"
                exit 1
            };

            [[ -f "$script" ]] || {
                prtclr "Script file does not exist: $script" "$clrerr" "e"
                exit 1
            };

        LOG="logs/${sensor}_$(date +%Y%m%d_%H%M%S).csv"
        
        echo "DEBUG sensor=[$sensor]"
        echo "DEBUG script=[$script]"
        ls -l "$script"
        head -n 5 "$script"

        echo "Logging ${samplesRecorded} samples to ${LOG} @${frequencySamples}Hz";
        
        if mpremote connect "$picoSerial" run "$script" 2>&1 | tee -a "$LOG"; then
            prtclr "Logging successful" "$clrnom" "n"
        else
            prtclr "Logging failure" "$clrerr" "e"
        fi
    done

    [[ -n $analysis ]] && [[ $analysis == "True" ]] && {

        latest=$(ls -lrt $rootFolder/logs/ | tail -n 1);
        echo "$latest";
    
    }
 
    [[ -n $debug ]] && [[ $debug == "True" ]] && {
        
        prtclr "Debug: $debug" "$clrstd" "n";
        prtclr "Analyze: $analysis" "$clrstd" "n";
        prtclr "Latest log: $latest" "$clrstd" "n";
        for i in "${prsact[@]}"; do
            prtclr "Parse options: ${i}" "$clrstd" "n";
        done        
        prtclr "$(boottime)" "$clrstd" "n";
        prtclr "$version" "$clrstd" "n";
        prtclr "$sensors" "$clrstd" "n";
    }